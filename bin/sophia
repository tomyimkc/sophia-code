#!/usr/bin/env bash
# Sophia Code open-edition launcher. Bakes SOPHIA_EDITION=oss.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export SOPHIA_EDITION="${SOPHIA_EDITION:-oss}"
export SOPHIA_RUNTIME_ROOT="${SOPHIA_RUNTIME_ROOT:-$ROOT}"
TUI="$ROOT/apps/sophia-tui/dist/index.js"
if [[ ! -f "$TUI" ]]; then
  echo "sophia: build the TUI first: (cd apps/sophia-tui && npm ci && npm run build)" >&2
  exit 1
fi
exec node "$TUI" "$@"
