{
  "name": "sophia-tui",
  "version": "0.12.16",
  "private": true,
  "description": "Sophia Code \u2014 provenance-aware, multi-backend terminal agent. canClaimAGI:false",
  "type": "module",
  "bin": {
    "sophia-tui": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/finalize-build.mjs",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "smoke:bridge": "node --import tsx scripts/smoke-bridge.mjs",
    "build:windows-exe": "node scripts/build-windows-exe.mjs",
    "bench:anims": "node --import tsx scripts/bench-anims.mjs",
    "sync-slash": "python3 ../../tools/export_slash_catalog.py --out src/lib/slash-commands.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.2.0",
    "react": "^19.2.8",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
